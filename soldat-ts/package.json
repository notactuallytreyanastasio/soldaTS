{
  "name": "soldat-ts",
  "private": true,
  "version": "0.0.0",
  "description": "OpenSoldat total rewrite — TypeScript, web-first. See ../docs/PORT-PLAN.md",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:strict": "STRICT_F32=1 vitest run",
    "play": "pnpm --filter @soldat/client dev",
    "dev": "pnpm --filter @soldat/client dev"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
