=== NEW FILE: server/GoldenMaster.pas (create verbatim) ===
Not expressible as a diff (new file). The dump procedures referenced above live here.
NUM_PARTICLES is pulled in via the Parts unit; values printed with 17 significant digits
and a '.' decimal separator so a Single round-trips exactly (see trace-format.md).

------------------------------------------------------------------------------------------
unit GoldenMaster;

interface

procedure GoldenBeginFrame(Tick, TickRate: Integer);
procedure GoldenWriteParticle(I: Integer; X, Y, VX, VY: Single);
procedure GoldenEndFrame;
procedure GoldenFlushAndExit;

var
  GoldenMaxTicks: Integer = 240;
  GoldenMasterSeed: LongInt = 1337;
  GoldenScenario: string = 'unnamed';
  GoldenTraceFile: string = 'golden_trace.json';

implementation

uses
  SysUtils, Classes;

var
  Buf: TStringList;          // accumulates JSON lines for all frames
  FrameStarted: Boolean = False;
  ParticlesInFrame: Integer = 0;
  HeaderWritten: Boolean = False;
  Fmt: TFormatSettings;

// 17 significant digits, '.' separator => exact Single round-trip. JSON has no NaN/Inf,
// so emit them as quoted strings for the comparator to flag (see trace-format.md).
function F(const V: Single): string;
begin
  if IsNan(V) then
    Result := '"NaN"'
  else if IsInfinite(V) then
    if V > 0 then Result := '"Infinity"' else Result := '"-Infinity"'
  else
    Result := Format('%.17g', [V], Fmt);
end;

procedure EnsureHeader(TickRate: Integer);
begin
  if HeaderWritten then Exit;
  Fmt := DefaultFormatSettings;
  Fmt.DecimalSeparator := '.';
  Fmt.ThousandSeparator := #0;
  Buf := TStringList.Create;
  Buf.Add('{');
  Buf.Add('  "tickRate": ' + IntToStr(TickRate) + ',');
  // GoldenScenario must be plain ASCII for the scenarios we ship; escape if that changes.
  Buf.Add('  "scenario": "' + GoldenScenario + '",');
  Buf.Add('  "frames": [');
  HeaderWritten := True;
end;

procedure GoldenBeginFrame(Tick, TickRate: Integer);
begin
  EnsureHeader(TickRate);
  // separate previous frame object with a comma
  if FrameStarted then
    Buf[Buf.Count - 1] := Buf[Buf.Count - 1] + ',';
  Buf.Add('    { "tick": ' + IntToStr(Tick) + ', "particles": [');
  FrameStarted := True;
  ParticlesInFrame := 0;
end;

procedure GoldenWriteParticle(I: Integer; X, Y, VX, VY: Single);
var
  Line: string;
begin
  Line := '      { "i": ' + IntToStr(I) +
          ', "x": ' + F(X) + ', "y": ' + F(Y) +
          ', "vx": ' + F(VX) + ', "vy": ' + F(VY) + ' }';
  if ParticlesInFrame > 0 then
    Buf[Buf.Count - 1] := Buf[Buf.Count - 1] + ',';
  Buf.Add(Line);
  Inc(ParticlesInFrame);
end;

procedure GoldenEndFrame;
begin
  Buf.Add('    ] }');
end;

procedure GoldenFlushAndExit;
begin
  Buf.Add('  ]');
  Buf.Add('}');
  Buf.SaveToFile(GoldenTraceFile);
  Buf.Free;
  Halt(0);
end;

end.
